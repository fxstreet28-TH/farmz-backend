# ---- Supabase (dedicated FarmZ project) ----
# The edge runtime injects SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY automatically
# on the hosted project; set them here only for local `supabase functions serve`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ---- Claim signer (NEW keypair dedicated to the backend — NOT the deploy wallet) ----
# Generate with: deno task gen-signer    Set on Supabase with: supabase secrets set CLAIM_SIGNER_PRIVATE_KEY=...
CLAIM_SIGNER_PRIVATE_KEY=

# ---- Chain / contracts (Base Sepolia) ----
FARMZ_TOKEN_ADDRESS=0xaA3639f77A827C5C8B16F7dB44aA4F54542Bb26B
FARMZ_CLAIM_ADDRESS=0xCd1602e8bbCacC20b1be251B572f663484E8702c
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---- Auth ----
# Comma-separated host[:port] values accepted in the SIWE message `domain` field (your frontend origins)
SIWE_ALLOWED_DOMAINS=localhost:5173,localhost:3000
# Synthetic email domain for wallet-only Supabase users (never receives mail)
WALLET_EMAIL_DOMAIN=wallet.farmz.invalid
CORS_ALLOW_ORIGIN=*

# ---- Internal ----
# >= 32 random chars; required to call the internal mission-progress function
INTERNAL_API_SECRET=

# ---- Claim policy (optional overrides) ----
CLAIM_MAX_PER_DAY=1000
CLAIM_MIN_AMOUNT=1
CLAIM_COOLDOWN_SECONDS=86400
CLAIM_SIGNATURE_TTL_SECONDS=3600
